# koti_defconfig — Linux for Koti-1 on the ULX3S 85F.
#
# Copied into arch/riscv/configs/ by .github/workflows/linux.yaml and built
# with `make ARCH=riscv CROSS_COMPILE=riscv64-linux-gnu- koti_defconfig`.
# Everything not named here takes its Kconfig default, so this file is only
# the places where koti differs from a stock kernel — which is the useful
# reading of it. sw/linux/check_config.py re-reads the RESOLVED .config
# afterwards and fails the build if any of it came out wrong; a defconfig line
# for a symbol whose dependencies are unmet is silently dropped by kconfig, so
# the file you write is not evidence of the kernel you get.
#
# The hardware this describes: RV32IMA + Zicsr + Zifencei, sv32, M/S/U,
# uniprocessor, no FPU, no compressed instructions, 16 MB of RAM at
# 0x0100_0000, an SBI v0.2 firmware whose console is the legacy v0.1 call, and
# a SiFive-register-compatible PLIC.

# ---- the architecture ------------------------------------------------------
# ARCH_RV32I depends on NONPORTABLE, so this pair is not optional: mainline
# treats RV32 as a configuration you have to promise you know you are asking
# for. HVC_RISCV_SBI depends on it too.
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y

# koti has neither. Leaving RISCV_ISA_C at its default y is not merely wasteful
# — the kernel would be built with compressed instructions the core cannot
# decode, and would die on an illegal instruction before it printed anything.
# CONFIG_RISCV_ISA_C is not set
# CONFIG_FPU is not set
# CONFIG_RISCV_ISA_V is not set

# ⚠️ And EFI is why the line above is not enough on its own. `config EFI` is
# `default y`, `depends on OF && !XIP_KERNEL && MMU` — all true here — and it
# does `select RISCV_ISA_C`. A `select` overrides a defconfig's "is not set",
# so asking for no compressed instructions and saying nothing about UEFI gets
# you compressed instructions anyway, with no warning. check_config.py caught
# this on its first run; without that step the build would have gone green and
# the kernel would have died on an illegal instruction with nothing printed.
# koti is booted by its own M-mode firmware, not by a UEFI stub, so this costs
# nothing besides the EFI stub, LIBFDT and UCS2_STRING it drops from the image.
# CONFIG_EFI is not set

# Runtime-patched extension support koti's core does not have. The alternatives
# framework would leave these unpatched (koti.dts lists neither in
# riscv,isa-extensions, and ZICBOM also wants riscv,cbom-block-size), so they
# are off for size and to remove a class of "the alternative got applied
# anyway" failure rather than because they are known to break.
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZICBOM is not set

# One hart. The firmware refuses the IPI and RFENCE extensions rather than
# faking them (probe_extension returns 0), which is the honest answer only
# while this stays off.
# CONFIG_SMP is not set

# ---- the console -----------------------------------------------------------
# This is the single most consequential line in the file. In 6.12 both the
# hvc console and earlycon prefer the SBI DBCN extension and fall back to the
# v0.1 calls only `if (IS_ENABLED(CONFIG_RISCV_SBI_V01))`. koti's firmware
# implements the legacy console (EID 1/2) and NOT DBCN, so without this the
# kernel boots with no way to say so — the failure mode is a silent machine,
# not an error.
CONFIG_RISCV_SBI_V01=y
CONFIG_HVC_RISCV_SBI=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
# CONFIG_SERIAL_8250 is not set
# ---- the screen as a Linux console (PLAN.md item 9b) -----------------------
# CONFIG_VT was OFF until 2026-08-08, and turning it on is what gives the
# keyboard's input events somewhere to go: drivers/tty/vt/keyboard.c is the only
# thing in the kernel that turns input events into console characters, it
# applies the keymap that `loadkeys` edits, and it feeds VTs — not hvc0.
#
# HW_CONSOLE comes with a console driver being present; koticon (a `struct
# consw` over koti's 40x30 character buffer) is that driver. It is a TEXT-mode
# console, not fbcon: koti has character cells in memory, not a pixel buffer,
# so no framebuffer or DRM stack is needed or wanted here.
#
# ⚠️ hvc0 STAYS. `console=hvc0` in bootargs keeps the serial console primary,
# so a bring-up session watching COM3 sees exactly what it saw before; tty1 is
# additional. Losing the serial console to a screen nobody is looking at would
# be a bad trade on a board being brought up.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_KOTICON=y

# ---- the machine description -----------------------------------------------
# The command line comes from koti.dts /chosen/bootargs. An empty built-in
# CMDLINE with CMDLINE_FROM_BOOTLOADER (the default) means the DTB wins.
CONFIG_CMDLINE=""

# ---- size -------------------------------------------------------------------
# Image is uncompressed and there is no bootloader to decompress anything, so
# the kernel occupies its own size in a 16 MB machine, twice over while the
# initramfs is still unpacked. Optimising for size is not a preference here.
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# ⚠️ The single biggest line in this file. STRICT_KERNEL_RWX is `default y` and
# makes vmlinux.lds.S use `#define SECTION_ALIGN PMD_SIZE` so that text, rodata
# and data can carry different permissions on whole megapages. On sv32 PMD_SIZE
# is 4 MiB, and there are four such boundaries — so the first build of this
# kernel came out at **20.44 MiB of which 16 was alignment padding**, against
# koti's 12 MiB of headroom. _etext was 1.8 MB. Without it SECTION_ALIGN is
# L1_CACHE_BYTES and the same kernel is about 4.5 MiB.
#
# What it costs: the kernel's own text stops being mapped read-only-execute.
# That is a hardening feature, not a correctness one, and it is the right thing
# to spend on a machine whose entire address space is 16 MB.
# CONFIG_STRICT_KERNEL_RWX is not set
CONFIG_EXPERT=y
# CONFIG_NET is not set
# CONFIG_MODULES is not set
# CONFIG_SUSPEND is not set
# CONFIG_PCI is not set

# ---- boot time ---------------------------------------------------------------
# ⚠️ CONFIG_CRYPTO is enabled for ONE reason and it is not cryptography: it is
# the gate that makes CONFIG_CRYPTO_MANAGER_DISABLE_TESTS exist at all.
#
# random.c selects CRYPTO_LIB_BLAKE2S, whose module_init runs
#     if (!IS_ENABLED(CONFIG_CRYPTO_MANAGER_DISABLE_TESTS) &&
#         WARN_ON(!blake2s_selftest())) ...
# With CRYPTO off that symbol does not exist anywhere in the tree, so
# IS_ENABLED() is false and the self-test runs UNCONDITIONALLY. There is no way
# to switch it off from outside the crypto menu.
#
# What that costs koti, measured on run 31031529894: the boot enters
# blake2s_mod_init at ~27.2M clocks and is STILL INSIDE IT at 60M — more than
# 33 million clocks hashing 256 test vectors and then a random-split test, with
# no output the whole time. Every boot before this had simply never got past it,
# and two separate sessions read that silence as a hang: first as an entropy
# wait, then as a stuck PLIC probe. It was neither. The machine was healthy and
# grinding through a self-test of a hash koti does not use.
#
# It is slow because the function is pathological for this cache:
# blake2s_compress_generic is 7964 bytes of unrolled straight-line code against
# a 4 KB I-cache (src/icache.sv, 512 x 64 bit), so a single pass evicts itself
# completely and every fetch misses. ~13 clocks per instruction, measured.
CONFIG_CRYPTO=y
CONFIG_CRYPTO_MANAGER_DISABLE_TESTS=y

# ---- the microSD, as a block device -----------------------------------------
# koti's own driver (sw/linux/koti_sd.c, injected into drivers/block by the
# workflow). Built IN, not a module: it is the device a root filesystem lives
# on, and a module cannot be loaded from a filesystem that is not mounted yet.
#
# READ-WRITE since 2026-08-07: CMD24 was added to the SPI engine upstream in
# console and re-vendored, so the card can now be written as well as read. It
# was read-only for one day, and that was hardware rather than a driver
# limitation.
CONFIG_KOTI_SD=y
# ext2 rather than ext4: ext4 is several hundred KB of code on a machine with
# 8.6 MB of RAM. ext2 is small, and unlike squashfs it is writable — which is
# exactly why it was chosen while the hardware still could not write.
# ⚠️ NO JOURNAL. An unclean shutdown can leave damage, so `sync` before pulling
# the power. That is the cost of ext2, stated rather than discovered.
CONFIG_EXT2_FS=y

# ---- the keyboard as an INPUT device ----------------------------------------
# Added 2026-08-08. Before this, Linux had no input subsystem at all: keystrokes
# arrived as console characters via the SBI firmware and nothing in the kernel
# knew a keyboard existed. This gives /dev/input/eventN, so key events, layouts
# and `loadkeys` become the OS's business.
# ⚠️ It does NOT make the login prompt work -- that has always come from the
# firmware feeding hvc0, and still does. hvc0 is a serial-style console and
# input devices do not feed it; that would need a VT plus a framebuffer console
# Linux knows about, which koti does not have (the HDMI text is drawn by the
# firmware). The two paths read separate ports of the same FIFO.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_KOTI=y
# The partition scanner. The card carries an MBR: one partition for the raw
# kernel image the firmware loads at LBA 2048, one for the filesystem.
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y

# ---- what init needs --------------------------------------------------------
# The rootfs is STILL a built-in initramfs, on purpose. The microSD block
# driver above is new and unproven on hardware, and switching `root=` to it
# before it has been seen working would turn a driver bug into a machine that
# does not boot at all. The safe order is: mount it by hand from the shell
# first, then move root onto it. INITRAMFS_SOURCE is set by the workflow, not
# here, because it is an absolute path in the build environment.
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# ---- what a first boot needs to be debuggable -------------------------------
# PRINTK_TIME because the first question about a boot that stops is always
# "where", and timestamps turn a truncated log into a bisection. KALLSYMS
# because a panic without symbols is a hex address on a machine with no
# debugger attached.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_KALLSYMS=y
CONFIG_LOG_BUF_SHIFT=16
CONFIG_HZ_100=y
