#!/bin/sh
#
# S45kotisd — mount the microSD, so what koti saved is there when it boots.
#
# PLAN item 14. `mount | grep kotisd` returned NOTHING on a booted machine, and
# the reason is a detail of /init: it mounts the card at /mnt to look for
# /sbin/init (rootfs-overlay/init:70), does not find one, and unmounts it again
# at line 77. Nothing ever mounts it back. So item 7's "koti saves files to the
# microSD" was true and useless — every session had to `mount /dev/kotisd2
# /mnt` by hand before it could reach anything it had saved.
#
# ⛔ WHY THIS IS A SCRIPT AND NOT A LINE IN /etc/fstab. Two reasons, and the
# first is the one that matters:
#
#   1. The card may already BE the root filesystem. /init switch_roots onto
#      /dev/kotisd2 when it carries an executable /sbin/init, and which of the
#      two happened is CARD STATE — no file in this tree knows it. An fstab
#      entry would then mount the live root a second time at /mnt, which is
#      legal, confusing, and exactly the kind of thing that looks fine until
#      something writes through the wrong one.
#   2. Overriding /etc/fstab means reproducing Buildroot's own entries (proc,
#      sysfs, devpts, tmpfs) from the overlay, where they would silently stop
#      tracking upstream. Adding a file costs nothing and takes nothing over.
#
# ⚠️ EVERY FAILURE PATH HERE ENDS IN A BOOTING MACHINE THAT SAYS WHY. That is
# the same rule sw/sbi/sdboot.c applies to the kernel transport and /init
# applies to the root filesystem: a missing card is a normal condition on a
# bring-up board, not a reason to stop.
#
# ⚠️ ext2 has NO JOURNAL and this machine is switched off by pulling a charger.
# `sync` before you do that. The `stop` case below unmounts cleanly, which
# helps only on the shutdowns that are clean.
#
# Copyright (c) 2026 Joonatan Alanampa
# SPDX-License-Identifier: Apache-2.0

DEV=/dev/kotisd2
MP=/mnt
# Default; each branch below sets it once the mount state is actually known.
#
# ⛔ IT IS NOT ALWAYS UNDER /mnt. If the card is the ROOT filesystem — which is
# what /init does whenever p2 carries an executable /sbin/init — then /mnt is
# empty and the persistent place is `/`. Leaving this hardcoded meant the clock
# silently stopped surviving reboots in exactly the configuration where the card
# is most obviously present, with no error: restore_clock would find no file and
# return 0, which is indistinguishable from a first boot.
#
# The decision lives in the `case` below rather than in the functions, so
# restore_clock and save_clock stay pure functions of $CLOCKFILE and can be
# tested without a card (sw/linux/test_rootfs_shell.sh does exactly that).
CLOCKFILE=$MP/.koti-clock

# ---------------------------------------------------------------------------
# The fake hardware clock — second half of PLAN item 13.
#
# ⚠️ THIS IS THE FALLBACK NOW, not the mechanism. Since PLAN item 28 koti has
# real clocks — the board's own MCP7940N (rtc0, always present, needs a CR1225
# in BAT1) and the DS3231 on J1 (rtc1, when it is plugged in) — and the kernel
# reads rtc0 before userspace starts. What is below runs when neither has ever
# been set, or when no cell is fitted, and is what koti did for its whole life
# before that.
#
# Without an RTC the kernel starts at the epoch and `date` answers 1970 on
# every boot. koti-net can fetch the real time out of any HTTP reply's Date
# header, but that needs the network up and the ESP32 awake, and the ESP32
# shares the microSD bus — not something to do at every boot.
#
# So: the last known time is written to the card, and restored here if it is
# LATER than what the kernel started with.
#
# ⚠️ IT IS MONOTONIC, NOT ACCURATE, and the difference is the whole design.
# This does not know the time; it knows a time that has definitely already
# passed. After a week unplugged the machine believes it is the moment it was
# switched off — wrong, but wrong in the one direction that keeps file
# timestamps in the order the files were written. `koti-net time` corrects it
# in one command, and either RTC corrects it permanently.
# ---------------------------------------------------------------------------

# ⭐ PREFER THE ACCURATE CLOCK, WHEN IT IS THERE. The kernel has already set
# the system time from rtc0 — the soldered-on MCP7940N — because that is the
# one that cannot be absent. rtc1 is the DS3231 on J1: a TCXO, about ±5 s a
# month against rtc0's ±1 minute. If it is present and holding a plausible
# time, take it, and write it back to rtc0 so the two agree and the NEXT boot
# starts from the better number even if the module has been unplugged by then.
#
# ⛔ THE PLAUSIBILITY TEST IS NOT DECORATION. An RTC that has never been set
# reads as 1970 (or 2000 for the MCP7940N), and adopting that would move the
# clock BACKWARDS by decades — breaking exactly the ordering property the fake
# clock below exists to protect. So: only adopt a year >= 2020.
adopt_better_rtc() {
	[ -e /dev/rtc1 ] || return 0
	command -v hwclock > /dev/null 2>&1 || return 0
	hwclock -f /dev/rtc1 -s > /dev/null 2>&1 || return 0
	yr=$(date -u +%Y 2>/dev/null)
	case "$yr" in ''|*[!0-9]*) return 0 ;; esac
	if [ "$yr" -lt 2020 ]; then
		echo "koti: /dev/rtc1 reads $yr — ignoring it, it has never been set"
		return 0
	fi
	echo "koti: clock from the DS3231 (rtc1): $(date -u)"
	# Keep the onboard one in step. It is the one that survives the module
	# being unplugged, so it is the one worth being right.
	hwclock -f /dev/rtc0 -w > /dev/null 2>&1
}
restore_clock() {
	[ -r "$CLOCKFILE" ] || return 0
	saved=$(cat "$CLOCKFILE" 2>/dev/null)
	case "$saved" in
		''|*[!0-9]*)
			echo "koti: $CLOCKFILE is not an epoch, ignoring it"
			return 0 ;;
	esac
	now=$(date -u +%s 2>/dev/null)
	case "$now" in ''|*[!0-9]*) now=0 ;; esac
	# ⛔ NEVER BACKWARDS. If the clock is already later than the saved value,
	# something has set it properly this boot (koti-net time, or a future
	# RTC) and this file is the stale one. Restoring unconditionally would
	# let a shutdown from last week overwrite a clock that is correct now.
	if [ "$saved" -gt "$now" ]; then
		if date -s "@$saved" > /dev/null 2>&1; then
			echo "koti: clock restored from the card: $(date -u)"
			echo "koti: (that is when this machine was last running, not" \
			     "now — run 'koti-net time' for the real thing)"
		fi
	fi
}

save_clock() {
	# Only worth saving a time that was actually set; writing 1970 back would
	# just carry the epoch forward and make restore_clock a no-op forever.
	yr=$(date -u +%Y 2>/dev/null)
	case "$yr" in ''|*[!0-9]*) return 0 ;; esac
	[ "$yr" -ge 2000 ] || return 0
	date -u +%s > "$CLOCKFILE" 2>/dev/null
}

# ---------------------------------------------------------------------------
# PLAN item 18: check the filesystem before mounting it.
#
# The kernel says `EXT2-fs (kotisd2): warning: mounting unchecked fs, running
# e2fsck is recommended` at every boot, and until now nothing ever did. ext2 has
# no journal and this machine is switched off by pulling a charger, so the
# warning is not boilerplate — it is the accurate description of a slow-burn
# risk on the only thing here that persists.
#
# ⛔ ONLY ON AN UNMOUNTED FILESYSTEM. e2fsck on a mounted rw filesystem
# corrupts it, which is why this runs in the not-root, not-yet-mounted branch
# and nowhere else. If the card is `/`, the branch above has already exited.
#
# `-p` is "preen": fix what is unambiguously safe, and refuse anything that
# needs a human. Exit codes are a bitmask — 0 clean, 1 errors corrected (fine,
# carry on), 2 corrected and a reboot is wanted, 4 and up left uncorrected.
# ⚠️ A DIRTY FILESYSTEM IS STILL MOUNTED. Refusing to mount would hide the
# user's files behind a failure they cannot act on from a machine with no
# rescue shell; saying loudly what was found and carrying on is the same
# choice /init makes about a missing card.
check_card() {
	# busybox's `fsck` applet is only a dispatcher and would exec a
	# fsck.ext2 that does not exist, so probe for the real checker. A rootfs
	# built without e2fsprogs mounts unchecked and says so, rather than
	# failing in a way that looks like a broken card.
	if ! command -v e2fsck > /dev/null 2>&1; then
		echo "koti: no e2fsck — mounting $DEV unchecked"
		return 0
	fi
	e2fsck -p "$DEV" > /dev/null 2>&1
	rc=$?
	if [ "$rc" -eq 0 ]; then
		return 0
	elif [ "$rc" -le 2 ]; then
		echo "koti: e2fsck repaired $DEV (exit $rc) — mounting it"
	else
		echo "koti: ⚠ e2fsck could NOT repair $DEV (exit $rc)."
		echo "koti:   Mounting anyway so your files are reachable, but run"
		echo "koti:   'umount /mnt; e2fsck -f $DEV' and read what it says."
	fi
	return 0
}

case "$1" in
	start)
		# Already the root filesystem? Then there is nothing to mount and
		# saying so is more useful than silence — it answers the question
		# "which root am I on" that docs/MANUAL.md says to read, not infer.
		if grep -q "^$DEV / " /proc/mounts 2>/dev/null; then
			echo "koti: the microSD IS / — nothing to mount"
			CLOCKFILE=/.koti-clock
			adopt_better_rtc
			restore_clock
			exit 0
		fi
		if grep -q " $MP " /proc/mounts 2>/dev/null; then
			echo "koti: $MP is already mounted"
			exit 0
		fi
		if [ ! -b "$DEV" ]; then
			# The ordinary cause is an empty slot. The block driver
			# registers whether or not a card answers, so the absence
			# shows up here as a missing partition rather than as a
			# missing disk.
			echo "koti: no $DEV — microSD not mounted (no card, or no" \
			     "partition 2)"
			exit 0
		fi
		check_card
		if mount -t ext2 -o rw "$DEV" "$MP" 2>/dev/null; then
			echo "koti: microSD mounted at $MP"
			CLOCKFILE=$MP/.koti-clock
			adopt_better_rtc
			restore_clock
		else
			echo "koti: $DEV would not mount at $MP — carrying on without it"
		fi
		;;
	stop)
		# rcK runs this on a clean shutdown. Save the clock first: the
		# unmount is what makes the write durable, and after it the file is
		# unreachable.
		if grep -q " $MP " /proc/mounts 2>/dev/null; then
			CLOCKFILE=$MP/.koti-clock
			save_clock
			sync
			umount "$MP" 2>/dev/null
		elif grep -q "^$DEV / " /proc/mounts 2>/dev/null; then
			# Root is the card: nothing to unmount, but the clock still
			# wants saving, and `sync` is the only thing that makes it
			# durable on a journal-less filesystem.
			CLOCKFILE=/.koti-clock
			save_clock
			sync
		fi
		;;
	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac
