#!/bin/sh
#
# S99koti — say, from userspace, that userspace is running.
#
# WHY THIS EXISTS. test/tb_boot.v needs one unambiguous string that only a
# working userspace can produce, and it must be OURS rather than borrowed from
# busybox's own output. A marker taken from a getty banner or /etc/issue would
# be a claim about how Buildroot happens to word things this release, and it
# would change under us on an upgrade with no warning and no failing test —
# just a boot that quietly stopped being checked.
#
# It runs last (S99) on purpose: everything else in /etc/init.d has already
# run, /proc and /dev are mounted, and the shell that runs this script is
# itself proof that execve, the dynamic-free static binary, the initramfs
# unpack and the console all worked.
#
# ⚠️ Keep the marker string in sync with MARKER in test/tb_boot.v. They are
# deliberately duplicated rather than generated: the bench must not learn what
# to expect from the thing it is testing.
#
# Copyright (c) 2026 Joonatan Alanampa
# SPDX-License-Identifier: Apache-2.0

case "$1" in
	start)
		# A little context first, because the interesting failures on real
		# hardware are "it booted but the machine is not what I think".
		# uname carries the kernel version and the machine name; the
		# memory line is how you find out the initramfs did not leave
		# enough room to do anything.
		/bin/busybox uname -a
		/bin/busybox grep -E '^MemTotal|^MemFree' /proc/meminfo
		echo "koti: userspace is alive"

		# ---- the keyboard layout for the SCREEN --------------------------
		# koti_kbd.c reports a KEYCODE and LINUX decides the character, so
		# the layout lives here now rather than in the gateware -- which is
		# the whole point of PLAN item 9, and also why `-` came out as `/`
		# until this line existed: the kernel's built-in keymap is US, and
		# HID usage 0x38 is "the key right of period", which differs by board.
		#
		# ⚠️ This is tty1 only. hvc0 still gets its characters from the
		# FIRMWARE's own Finnish table in sw/usbkbd.c, so the two consoles
		# agree only because both are Finnish -- they are separate tables and
		# changing one does not change the other.
		#
		# The map is generated by `loadkeys --bkeymap fi` in CI from the kbd
		# project's upstream data; busybox has loadkmap built in, so nothing
		# but the ~2 KB file ships.
		if [ -f /etc/koti-fi.bmap ]; then
			if /bin/busybox loadkmap < /etc/koti-fi.bmap; then
				echo "koti: fi keymap loaded"
			else
				echo "koti: fi keymap FAILED"
			fi
		fi

		# ⛔ THE SPEAKERS ON THIS BENCH HAVE NO VOLUME CONTROL, so the
		# only place loudness can be set is here and in `koti play`.
		# The R2R ladder swings toward 3.3 V logic levels into a jack
		# that a powered speaker expects line level from, so full scale
		# is not a neutral default — it is the loud end of a range with
		# nothing downstream to trim it.
		#
		# The value lives on the CARD, not in this file: the rootfs is
		# an initramfs in RAM, so a number edited here would be lost at
		# the next boot AND would need a 30-minute rebuild plus a card
		# write to change. /mnt/koti-volume is one `echo` away and
		# survives a power cycle, which is what a setting should be.
		if [ -w /sys/module/koti_snd/parameters/volume ]; then
			_kv=$(cat /mnt/koti-volume 2>/dev/null)
			case "$_kv" in
				''|*[!0-9]*) _kv=1 ;;
			esac
			[ "$_kv" -gt 15 ] && _kv=15
			echo "$_kv" > /sys/module/koti_snd/parameters/volume
			echo "koti: bell volume $_kv/15 (echo N > /mnt/koti-volume)"
		fi
		;;
	stop)
		;;
	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac
