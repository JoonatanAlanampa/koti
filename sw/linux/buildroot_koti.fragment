# buildroot_koti.fragment — what koti needs that a stock Buildroot config does
# not give it.
#
# APPLIED AS A FRAGMENT, NOT AS A WHOLE DEFCONFIG, and that is deliberate. A
# hand-written Buildroot defconfig for a niche target is a long list of symbols
# nobody can check without running a 40-minute build, and Buildroot drops a
# symbol whose dependencies are unmet exactly the way kconfig does — silently.
# So .github/workflows/userspace.yaml starts from an in-tree defconfig that is
# already known to build (qemu_riscv32_virt), appends this, and runs
# `make olddefconfig`. Only the lines koti genuinely requires live here, and
# every one of them is asserted afterwards against the RESOLVED .config.
#
# ⚠️ THE ONE THAT MATTERS MOST IS RVC. koti's core cannot decode compressed
# instructions, and Buildroot's RISC-V default enables them. A userspace built
# with C would produce binaries that die on an illegal instruction the moment
# execve lands on one — the same failure the kernel side already hit, where
# `config EFI` quietly selected RISCV_ISA_C behind a defconfig that had asked
# for it to be off. That cost a build there. In userspace it would cost more,
# because the kernel would be fine and only programs would die.

# rv32, and spell out the ISA rather than take "general purpose" (G), which
# means IMAFD — koti has no FPU at all.
#
# ⚠️ The symbols are BR2_RISCV_ISA_RV*, NOT BR2_RISCV_ISA_CUSTOM_RV*. The first
# version of this file used the CUSTOM_ spelling, every line was silently a
# no-op, and `make olddefconfig` resolved to **RVF=y and RVD=y** — a toolchain
# emitting floating-point instructions for a core with no FPU. Nothing in the
# fragment complained, because a kconfig line for a symbol that does not exist
# is not an error. That is the entire reason sw/linux/check_rootfs.py reads the
# RESOLVED config instead of trusting this file, and it caught it on the first
# run, before the forty-minute build rather than after it.
BR2_riscv=y
BR2_RISCV_32=y
BR2_riscv_custom=y
BR2_RISCV_ISA_RVI=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
# BR2_RISCV_ISA_RVF is not set
# BR2_RISCV_ISA_RVD is not set
# BR2_RISCV_ISA_RVC is not set
# BR2_RISCV_ISA_RVV is not set

# sv32. koti has an MMU and mainline RV32 expects one; a nommu userspace would
# be a different (and much stranger) target.
BR2_RISCV_USE_MMU=y

# Soft float, matching -mabi=ilp32 everywhere else in this project. ILP32F and
# ILP32D would pass floats in F registers koti does not have.
BR2_RISCV_ABI_ILP32=y

# koti supplies its own everything below the rootfs: the kernel is built by
# .github/workflows/linux.yaml from sw/linux/koti_defconfig, and the M-mode
# firmware in sw/sbi IS the SBI implementation. Buildroot must not build a
# kernel, a bootloader or OpenSBI — they would be silently unused at best and
# confusing artifacts at worst.
# BR2_LINUX_KERNEL is not set
# BR2_TARGET_OPENSBI is not set
# BR2_TARGET_UBOOT is not set

# BOTH, and both are load-bearing — this is not belt and braces.
#
# The cpio is still the initramfs inside the kernel Image, and it is now the
# FALLBACK: sw/linux/rootfs-overlay/init tries to switch_root onto the card and
# drops back to it when the card is absent, unformatted or not a rootfs. Delete
# the cpio and a missing card becomes an unbootable board, which is the outcome
# sw/sbi/sdboot.c already refused to accept one layer down.
#
# The ext2 is what goes on the card's p2, written with
# `python tools/sdkernel.py writefs rootfs.ext2`. It is built by Buildroot
# rather than assembled from the cpio by hand because only Buildroot gets the
# device nodes, ownership and permissions right without root — and a rootfs
# whose /dev/console is missing or whose /sbin/init is mode 644 fails at the
# worst possible moment, after switch_root has already discarded the initramfs.
#
# ⚠️ SIZE: the image is written into p2 as a fixed-size blob, so this is the
# filesystem size, NOT the partition size (p2 is ~29 GB). 16M leaves room to
# install things without a rebuild; resize2fs can grow it on the machine later.
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_2=y
BR2_TARGET_ROOTFS_EXT2_SIZE="16M"
BR2_TARGET_ROOTFS_EXT2_LABEL="kotiroot"
# BR2_TARGET_ROOTFS_TAR is not set

# ⚠️ The console is hvc0 — the SBI console sw/sbi/sbi.c implements — and NOT a
# ttyS. koti has no 16550 and koti.dts has no serial node, so a getty spawned
# on ttyS0 would open nothing, respawn, and fill the log while the machine
# looked alive but unusable.
BR2_TARGET_GENERIC_GETTY_PORT="hvc0"

# ⭐ AND A SECOND GETTY, ON tty1 — the screen. sw/linux/post-build.sh appends it
# to the generated inittab, which is the only way to ADD one: this symbol takes
# a single port, so setting it to tty1 would MOVE the login off the serial line
# rather than put one on the monitor. koti's UART is transmit-only, so the
# serial login is the one that must not be lost.
# Without that script koticon renders kernel messages and nothing else, because
# /dev/console is hvc0 and no shell runs on the VT.
BR2_ROOTFS_POST_BUILD_SCRIPT="../sw/linux/post-build.sh"

# Keep it small. koti has ~8.4 MB free after the kernel (measured: "Memory:
# 8468K/12288K available"), and an initramfs costs that space twice while it is
# being unpacked. Busybox alone is the whole point of this rung: a shell.
BR2_INIT_BUSYBOX=y

# ⚠️ musl and static, and this is a SIZE decision with a measurement behind it.
# The first successful build (run 31038903545) used the base defconfig's glibc
# and came out at 4.09 MiB, of which:
#     1634664  lib/libc.so.6
#     1174756  lib/libm.so.6
#      939668  bin/busybox
#      185244  lib/ld-linux-riscv32-ilp32.so.1
#      157204  lib/libgcc_s.so.1
# — 2.8 MB of it glibc, with everything already stripped. That does not fit.
# The cpio rides inside the kernel Image AND is unpacked into tmpfs, so it
# costs its own size roughly twice against a 12 MiB window that already spends
# ~3.8 MB on the kernel and its early allocations.
#
# musl folds libm into libc and is a fraction of the size; static linking then
# removes the shared objects and the dynamic loader outright, leaving
# essentially one binary. sw/linux/check_rootfs.py enforces the budget so this
# cannot quietly regrow.
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_STATIC_LIBS=y

# One file: /etc/init.d/S99koti, which prints the marker test/tb_boot.v waits
# for. The bench needs a string only a working userspace can produce, and it
# has to be OURS — a marker borrowed from a getty banner or /etc/issue is a
# claim about how Buildroot words things this release, and would change under
# us on an upgrade with no failing test, just a boot that quietly stopped
# being checked.
BR2_ROOTFS_OVERLAY="../sw/linux/rootfs-overlay"

# ⚠️ NO NETWORK INTERFACE, AND THIS COSTS 375 MILLION CLOCKS IF LEFT ALONE.
#
# The base is qemu_riscv32_virt_defconfig, which has a virtio-net and therefore
# sets BR2_SYSTEM_DHCP="eth0". That is inherited configuration for hardware koti
# does not have and will not have: there is no MAC anywhere in src/, and none is
# planned. Buildroot turns that symbol into an /etc/network/interfaces stanza
#
#     auto eth0
#     iface eth0 inet dhcp
#       wait-delay 15
#
# and ships /etc/network/if-pre-up.d/wait_iface, which on an interface that does
# not exist does exactly what it says:
#
#     while [ ${IF_WAIT_DELAY} -gt 0 ]; do ... sleep 1 ... done
#
# Fifteen sleeps of one second each. koti's timebase is 25 MHz, so that is
# 375,000,000 clocks of simulated time burned by S40network — BEFORE S99koti
# runs — against a full-boot budget of 250M. A boot that reaches userspace
# perfectly would still have been reported INCOMPLETE, and the clocks would have
# gone somewhere nobody was looking, because the wait happens inside a script
# whose output ("Waiting for interface eth0 to appear....") looks like progress.
#
# Found by reading the committed rootfs on 2026-08-06, before spending the hour.
# sw/linux/check_initramfs.py now asserts the RESULT — that nothing but lo is
# configured — rather than this symbol, because what stalls the boot is the
# generated file, and more than one setting can produce it.
BR2_SYSTEM_DHCP=""
