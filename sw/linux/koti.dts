/*
 * koti.dts — the machine description Linux gets handed in a1.
 *
 * This describes what SUPERVISOR mode can see, which is why several things you
 * might expect are deliberately absent:
 *
 *   no CLINT node   — mtime/mtimecmp are M-mode registers. S-mode reaches the
 *                     timer through the SBI TIME extension, so the kernel wants
 *                     `timebase-frequency` and the CPU-local interrupt
 *                     controller, not an MMIO range it cannot legally touch.
 *   no serial node  — koti's UART is transmit-only at a core-internal MMIO
 *                     address and is not a 16550. The console is the SBI one,
 *                     and it needs CONFIG_RISCV_SBI_V01 because koti's
 *                     firmware answers the legacy calls and not DBCN.
 *   keyboard@60000  — ADDED 2026-08-08, with a driver of koti's own
 *                     (sw/linux/koti_kbd.c). Mainline binds to nothing here:
 *                     a soft USB host core is neither EHCI nor OHCI, exactly
 *                     as the PS/2 word this replaced was not an i8042. What
 *                     changed is that the driver now exists.
 *
 * (A PLIC node WAS absent for the same reason until 2026-08-04, when
 * src/plic.sv was built. It is here now, under /soc.)
 *
 * Build:  dtc -I dts -O dtb -o koti.dtb koti.dts   (the `dtb` job in
 *         .github/workflows/linux.yaml; the resulting blob is committed as
 *         koti.dtb because the firmware is built on a host with no dtc)
 *
 * Copyright (c) 2026 Joonatan Alanampa
 * SPDX-License-Identifier: Apache-2.0
 */

/dts-v1/;

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	compatible = "joonatanalanampa,koti1";
	model = "Koti-1 (ULX3S 85F)";

	/*
	 * ⛔ WHICH CLOCK THE KERNEL TRUSTS AT BOOT, AND IT IS NOT THE ACCURATE
	 * ONE. CONFIG_RTC_HCTOSYS_DEVICE is the string "rtc0", and rtc0 is
	 * whichever RTC registers first unless an alias pins it — drivers/rtc/
	 * class.c calls of_alias_get_id(node, "rtc") and uses that as the
	 * device id.
	 *
	 * koti has two, and they differ in a way that decides this:
	 *   the MCP7940N is SOLDERED TO THE BOARD and is always there;
	 *   the DS3231 hangs off J1 on four wires and may not be plugged in.
	 *
	 * If the DS3231 were rtc0, then on a machine with nothing plugged into
	 * J1 there would BE no rtc0 — hctosys would log "unable to open rtc
	 * device (rtc0)" and the machine would boot at the epoch while a
	 * perfectly good clock sat on the board unread. So rtc0 is the one that
	 * cannot be absent, and the better clock is rtc1.
	 *
	 * ⚠️ That means the boot-time clock is the ~1 min/month one. Userspace
	 * takes the DS3231's reading when it is present — see the rtc1 handling
	 * in rootfs-overlay/etc/init.d/S45kotisd — which is the right place for
	 * a policy that depends on what is plugged in.
	 */
	aliases {
		rtc0 = &mcprtc;
		rtc1 = &ds3231;
	};

	chosen {
		/*
		 * hvc0 is the SBI console: koti has no device Linux would bind a
		 * tty to, so the kernel's only way out is the firmware call the
		 * payload already uses. earlycon=sbi is what makes the boot
		 * visible before the console driver probes — without it a kernel
		 * that dies early dies silently, which on a machine being brought
		 * up for the first time is the difference between a bug and a
		 * mystery.
		 */
		/*
		 * root= names the card's second partition, the ext2 filesystem
		 * tools/sdkernel.py writes. It is here rather than hardcoded in
		 * /init so the device lives in ONE place.
		 *
		 * ⚠️ The kernel itself never acts on this. An initramfs is built
		 * in, so the kernel runs /init and never reaches its own root=
		 * handling; sw/linux/rootfs-overlay/init is what reads this out of
		 * /proc/cmdline and switch_roots onto it. That indirection is
		 * deliberate — the kernel's root= answers a missing card with a
		 * panic, and /init answers it by staying in RAM and saying why.
		 * Changing this line therefore changes where root comes from, but
		 * only via /init, and only after a firmware reflash since the DTB
		 * ships in flash.
		 */
		/*
		 * ⭐ TWO consoles, and the ORDER is load-bearing. printk goes to
		 * every `console=` listed, so tty1 is what puts kernel messages
		 * on the HDMI monitor through koticon (PLAN.md item 9b) — without
		 * it koticon owns the screen and nothing ever writes to it, which
		 * renders as a perfectly working BLANK display. That is exactly
		 * what the first hardware test showed.
		 *
		 * ⚠️ hvc0 is LAST because the last `console=` becomes /dev/console,
		 * and therefore where the login prompt lives. Keeping it on the
		 * serial line means a bring-up session watching COM3 still sees
		 * the prompt it expects. Swapping the order moves the login to the
		 * screen — which is desirable eventually, but it needs a getty on
		 * tty1 and it should be a deliberate change, not a side effect of
		 * how this string is ordered.
		 *
		 * ⚠️ koti's UART IS TRANSMIT-ONLY. A serial console here can be
		 * read and never typed at; every keystroke arrives through the USB
		 * keyboard and SBI console_getchar. Do not assume a serial console
		 * implies a serial terminal.
		 */
		bootargs = "console=tty1 console=hvc0 earlycon=sbi random.trust_bootloader=1 root=/dev/kotisd2 rootfstype=ext2 rw";

		/*
		 * ⚠️ THIS SEED IS NOT SECRET AND NOT RANDOM. It is a fixed
		 * constant committed to a public repository, and the bytes are
		 * deliberately patterned so that nobody can mistake it for
		 * entropy. It exists to make the machine usable, not secure.
		 *
		 * WHY IT IS HERE. Until the CRNG is seeded, `crng_init` is
		 * CRNG_EMPTY, and crng_make_state() takes a branch that runs a
		 * full extract_entropy() — a BLAKE2s hash of the whole input
		 * pool — on EVERY SINGLE random draw. Read straight off the
		 * disassembly: `bnez a4, +0xc` skips the extract_entropy call
		 * once crng_init is non-zero. The kernel draws random numbers
		 * constantly (hashing, path walking, the allocator), so on koti
		 * that branch cost 34% of all machine time, measured on the
		 * traced run 31038739162. The boot was not stuck — every one of
		 * its random numbers was costing a hash.
		 *
		 * Crediting the seed moves crng_init off CRNG_EMPTY, which is
		 * all it takes to retire that branch. It needs
		 * random.trust_bootloader=1 above, because
		 * CONFIG_RANDOM_TRUST_BOOTLOADER is not available in this
		 * config and add_bootloader_randomness() only credits what it
		 * is told to trust. Linux erases the property from the DTB
		 * after reading it, which is why nothing downstream sees it.
		 *
		 * ⛔ THE REAL FIX IS A HARDWARE ENTROPY SOURCE. koti has a whole
		 * FPGA to put a ring-oscillator TRNG in, and once one exists
		 * this property should be deleted rather than kept alongside
		 * it. Until then: do not put anything on this machine that
		 * depends on unpredictable numbers, because there are none.
		 */
		rng-seed = [
			6b 6f 74 69 20 66 69 78 65 64 20 73 65 65 64 2c
			20 6e 6f 74 20 73 65 63 72 65 74 2c 20 6e 6f 74
			20 72 61 6e 64 6f 6d 2e 20 73 65 65 20 6b 6f 74
			69 2e 64 74 73 20 66 6f 72 20 77 68 79 2e 0a 00
		];
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		/*
		 * clint.sv increments mtime once per core clock and the core runs
		 * at 25 MHz, so the timebase IS the core clock. If the core clock
		 * ever changes, this number must change with it: Linux derives
		 * every delay and the whole scheduler tick from it, and a wrong
		 * value does not fail — it just makes the machine run at the
		 * wrong speed while looking fine.
		 */
		timebase-frequency = <25000000>;

		cpu@0 {
			device_type = "cpu";
			reg = <0>;
			status = "okay";
			compatible = "riscv";
			riscv,isa-base = "rv32i";
			riscv,isa-extensions = "i", "m", "a", "zicsr", "zifencei";
			mmu-type = "riscv,sv32";
			clock-frequency = <25000000>;

			cpu0_intc: interrupt-controller {
				#interrupt-cells = <1>;
				compatible = "riscv,cpu-intc";
				interrupt-controller;
			};
		};
	};

	/*
	 * RAM: the whole 32 MB part, all of it addressable since 2026-08-08.
	 * (It used to be 16 MB because `addr[22]` was spent as the flash/RAM
	 * device select; the core's word address is 24 bits now and the select
	 * is `a[23:22] != 00`. There is no longer a second build with a
	 * different answer — koti is FPGA-only.)
	 */
	memory@1000000 {
		device_type = "memory";
		/*
		 * 32 MB since 2026-08-08 (PLAN.md item 12). It was 0x01000000 —
		 * and that was CORRECT for the hardware as built, because the
		 * core's word address was 23 bits with a[22] spent as the
		 * flash/RAM device select, so half the soldered part could not
		 * be addressed at all. The bus is 24 bits now and RAM spans
		 * a[23:22] == 01 and 10, i.e. 0x0100_0000..0x02FF_FFFF.
		 *
		 * ⚠️ This length is a PROMISE to the kernel, not a request: make
		 * it larger than what the select actually reaches and Linux
		 * will hand out pages that alias onto memory it is already
		 * using, which corrupts long after the fact and never points
		 * here. It must move in the same commit as src/project.sv.
		 */
		reg = <0x01000000 0x02000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * The M-mode firmware's own RAM: .bss, the M and S stacks
		 * (0x0100_6000 / 0x0100_7000) and the VGA charbuf (0x0100_8000,
		 * 40x30 bytes). All of it fits inside 64 KB.
		 *
		 * The reservation is 64 KB and not the whole 4 MiB below the
		 * kernel, because the 4 MiB constraint applies to where the KERNEL
		 * may load, not to how much has to be kept away from Linux. RV32
		 * Linux maps all of RAM linearly and is perfectly happy to hand
		 * out pages below its own image, so reserving the rest would throw
		 * away about 4 MB for nothing.
		 *
		 * Leaving this node out entirely is not a subtle failure but it is
		 * a confusing one: the kernel boots and then corrupts itself the
		 * first time the firmware takes a trap and pushes a frame.
		 *
		 * The DTB itself is NOT reserved here on purpose. It sits at
		 * 0x013F_0000 in ordinary memory and Linux reserves it for itself
		 * via early_init_fdt_reserve_self(); putting it in a `no-map`
		 * region instead would take it out of the linear map that the
		 * early FDT code expects to read it through.
		 */
		fw_reserved: firmware@1000000 {
			reg = <0x01000000 0x00010000>;
			no-map;
		};
	};

	/*
	 * The SBI timer. Not an MMIO device — the driver issues the TIME
	 * extension call that sbi.c implements and takes the S-mode timer
	 * interrupt (cause 5) the firmware injects.
	 *
	 * It sits at the ROOT and not under /soc on purpose. /soc is a
	 * `simple-bus`, every child of which is expected to have a `reg`, and
	 * this node has no registers to name — dtc says so
	 * (`simple_bus_reg: missing or empty reg/ranges property`). A node with
	 * no address does not belong on a bus.
	 */
	timer {
		compatible = "riscv,timer";
		interrupts-extended = <&cpu0_intc 5>;
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;

		/*
		 * src/plic.sv is register-compatible with the SiFive PLIC, so
		 * mainline's driver runs it unmodified. That is the whole reason it
		 * occupies 4 MB of address space: the context registers live at
		 * offset 0x200000 and the driver hard-codes that.
		 *
		 * ONE entry in interrupts-extended, and it is the S-mode one. The
		 * driver derives the hardware context index from the POSITION in
		 * this list, so a single S entry means it drives context 0 — which
		 * is the only context the RTL implements. Adding an M-mode entry
		 * first, as a fuller PLIC's devicetree would, silently shifts the
		 * supervisor context to 1 and the driver would then program
		 * registers that do not exist.
		 *
		 * riscv,ndev is 4: source IDs 1..4, of which only 1 (the keyboard)
		 * is currently wired in project.sv.
		 */
		plic0: interrupt-controller@c00000 {
			compatible = "sifive,plic-1.0.0";
			reg = <0x00c00000 0x00400000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			#address-cells = <0>;
			interrupts-extended = <&cpu0_intc 9>;
			riscv,ndev = <4>;
		};

		/*
		 * The microSD controller — src/sd_ctrl.sv, four registers over a
		 * vendored SPI-mode engine. NOT an SDHCI and not an MMC host, so
		 * mainline has no driver for it; sw/linux/koti_sd.c is the one it
		 * gets. The same is true of the PS/2 word and the USB core, and was
		 * planned for rather than discovered.
		 *
		 * NO INTERRUPT PROPERTY, because sd_ctrl has no IRQ line. The driver
		 * polls SD_DONE. Adding `interrupts` here would describe hardware
		 * that does not exist and the driver would wait forever for it.
		 *
		 * `koti,sectors` exists because the engine never reads the card's
		 * CSD, so nothing on the machine can ask how big the card is — it
		 * has to be declared. 61067264 sectors is the MEASURED size of the
		 * card on the bench (29.12 GiB), read from the host rather than
		 * assumed — the first value written here was 61071360, a guess from
		 * the rounded capacity, and it was 4096 sectors TOO LARGE.
		 * ⚠️ TOO SMALL only hides the tail of the card; TOO LARGE lets the
		 * partition scanner read past the end and report IO errors on a
		 * perfectly healthy card. Shrink rather than guess upward.
		 */
		sd0: mmc@50000 {
			compatible = "koti,sd-1";
			reg = <0x00050000 0x00010000>;
			koti,sectors = <61067264>;
		};

		/*
		 * The USB HID keyboard block, src/usb_kbd.sv. Added 2026-08-08.
		 *
		 * ⚠️ Linux does NOT own this keyboard exclusively, and the driver
		 * says so: koti's M-mode SBI firmware reads register +0x00 to feed
		 * the hvc0 console (that is what makes the login prompt typeable),
		 * while sw/linux/koti_kbd.c reads +0x08. They are two independent
		 * read pointers over one queue of keystrokes, so neither steals
		 * from the other -- the same way a PC delivers a keypress to the
		 * console and to /dev/input at once.
		 *
		 * PLIC source 1. The interrupt follows the LINUX port, not the
		 * firmware's: it exists to raise `seip`, which is supervisor
		 * external, so tying it to the firmware's queue would let the
		 * firmware's reads lower a line meant for Linux.
		 */
		kbd0: keyboard@60000 {
			compatible = "koti,usb-kbd-1.0";
			reg = <0x00060000 0x00010000>;
			interrupt-parent = <&plic0>;
			interrupts = <1>;
		};

		/*
		 * The ESP32 link — src/esp_uart.sv, PLAN item 11. This is koti's
		 * only route to a network: the onboard ESP32 over its own serial
		 * pair on K3/K4, with a 64-byte receive FIFO and PLIC source 2.
		 *
		 * ⛔ IT IS NOT A 16550 AND MAINLINE BINDS TO NOTHING HERE, the
		 * same as the keyboard above. `ns16550a` would be a lie that
		 * ends in a driver poking registers that are not there.
		 *
		 * ⚠️ The node does NOT wake the ESP32. esp_uart's control
		 * register resets to 0, holding it in reset, and the chip's
		 * GPIOs are the microSD bus — see the experiment in
		 * fpga/ulx3s/README.md 2e. A driver binding here gets a serial
		 * port; making the far end run is a separate, deliberate act.
		 */
		esp0: serial@70000 {
			compatible = "koti,esp-uart-1.0";
			reg = <0x00070000 0x00010000>;
			interrupt-parent = <&plic0>;
			interrupts = <2>;
			clock-frequency = <25000000>;
			current-speed = <115200>;
		};

		/*
		 * Sound — src/audio_r2r.sv + vendor/audio.sv, PLAN item 21.
		 * Four voices, one 32-bit register each, straight onto the
		 * board's 3.5 mm jack through its 4-bit R2R ladder.
		 *
		 *   +0..+C  voice 0..3
		 *   [15:0]  freq, phase increment; Hz = freq * 0.745058
		 *   [19:16] volume 0-15, 0 = silent
		 *   [21:20] wave: 0 square, 1 triangle, 2 noise, 3 off
		 *
		 * ⛔ NO INTERRUPT, and that is not an omission. The synth runs
		 * free in fabric once written: a voice sounds until software
		 * silences it, so there is no event for the CPU to be told
		 * about. A driver here starts and stops notes; it never
		 * services them.
		 *
		 * 🪤 THIS NODE COST A REFLASH TO ADD, and would have cost a
		 * SECOND one if it had been left for later — the DTB lives
		 * inside the SBI firmware, which is baked into the bitstream.
		 * It rides along with the bitstream that first carried the
		 * audio pins for exactly that reason.
		 */
		snd0: audio@80000 {
			compatible = "koti,audio-1.0";
			reg = <0x00080000 0x00010000>;
			clock-frequency = <25000000>;
		};

		/*
		 * The I2C bus, and the DS3231 real-time clock on it — PLAN.md
		 * item 28, hardware src/i2c_bit.sv, driver sw/linux/koti_i2c.c.
		 *
		 * ⭐ THIS IS THE FIRST NODE ON koti WHOSE *CHILD* IS DRIVEN BY
		 * MAINLINE. koti's own blocks all needed drivers of koti's own,
		 * because a soft USB host is not an EHCI, its SD engine is not an
		 * SDHCI and its UART is not a 16550. The RTC is different: it is
		 * a real Maxim part on a real I2C bus, so once the bus exists,
		 * drivers/rtc/rtc-ds1307.c binds to it unmodified and koti gets
		 * /dev/rtc0, hwclock, and the kernel setting its own clock at
		 * boot — none of which is code anybody here has to maintain.
		 * Everything koti had to write is the two-bit bus underneath.
		 *
		 * NO INTERRUPT PROPERTY. The DS3231's INT/SQW output is wired to
		 * a pin (gn[8], A5) and is readable as bit 4 of the block's
		 * register, but it is NOT routed to the PLIC — so alarms cannot
		 * wake anything and this node must not claim they can. rtc-ds1307
		 * checks for an IRQ and simply leaves alarm support off without
		 * one, which is the honest configuration. Wiring it up later is a
		 * PLIC source and a reflash, and the pin is already there for it.
		 *
		 * 🪤 LIKE THE SOUND NODE, THIS COSTS A REFLASH TO ADD. The DTB
		 * lives inside the M-mode firmware, which is baked into the
		 * bitstream — so it rides along with the bitstream that first
		 * carries the I2C pins, and adding it later would cost a second
		 * `fujprog -j flash` for nothing.
		 */
		i2c0: i2c@90000 {
			compatible = "koti,i2c-bit-1.0";
			reg = <0x00090000 0x00010000>;
			#address-cells = <1>;
			#size-cells = <0>;

			/*
			 * "maxim,ds3231" is rtc-ds1307.c's own compatible
			 * string in 6.12 (read out of the driver's
			 * of_device_id table, not remembered). 0x68 is the
			 * DS3231's fixed 7-bit address — the part has no
			 * address pins, so there is nothing to configure and
			 * nothing to get wrong.
			 *
			 * ⚠️ The common ZS-042 module also carries an AT24C32
			 * EEPROM at 0x57. It is deliberately NOT described
			 * here: koti has no use for 4 KB of EEPROM, and a node
			 * for a chip that a different module may not have
			 * would produce a probe failure in the boot log on
			 * every machine that has the other kind. `i2cdetect -y
			 * 0` finds it either way.
			 */
			ds3231: rtc@68 {
				compatible = "maxim,ds3231";
				reg = <0x68>;
			};
		};

		/*
		 * The SECOND I2C bus — and the RTC THE BOARD ALREADY HAD.
		 *
		 * ⭐ The ULX3S carries a populated MCP7940N (U7) with its own
		 * 32.768 kHz crystal (Y2) and a CR1225 holder (BAT1), wired
		 * straight to the FPGA on balls E12/B19 with 3.3k pull-ups
		 * fitted. Nothing in this project had noticed until the user
		 * asked what the coin cell on the back was for. It needs no
		 * soldering and no header — only the cell.
		 *
		 * Same block as bus 0, second instance (src/i2c_bit.sv), and
		 * the SAME driver again: rtc-ds1307.c matches
		 * "microchip,mcp7940x" as well as "maxim,ds3231". Two RTCs,
		 * two busses, one driver file, none of it koti's.
		 *
		 * ⚠️ THIS BUS IS SHARED WITH THE HDMI CONNECTOR'S DDC PINS
		 * through a PCA9306 translator — that is how a board reads a
		 * monitor's EDID. A monitor may therefore answer at 0x50 on
		 * this bus. Harmless (different address), and worth knowing
		 * before someone reads an unexpected device as a fault.
		 */
		i2c1: i2c@a0000 {
			compatible = "koti,i2c-bit-1.0";
			reg = <0x000a0000 0x00010000>;
			#address-cells = <1>;
			#size-cells = <0>;

			/*
			 * 0x6F is fixed in the MCP794xx family — the part has
			 * no address pins. Its alarm output is NOT wired to
			 * the FPGA at all: it goes through two diodes into the
			 * board's power path, so it can switch the BOARD on
			 * rather than interrupt the CPU. No `interrupts`
			 * property, for the same reason as the DS3231 above.
			 */
			mcprtc: rtc@6f {
				compatible = "microchip,mcp7940x";
				reg = <0x6f>;
			};
		};

		/*
		 * The 40x30 text console — PLAN.md item 9b, driver
		 * sw/linux/koticon.c. `reg` is the VGA register block, NOT the
		 * character buffer: the buffer is ordinary RAM that the driver
		 * allocates for itself, and `VGA_BASE` (offset 0x04) is how the
		 * raster is told where it is.
		 *
		 * ⭐ That register is why this needed no ownership protocol with
		 * the firmware. M-mode keeps drawing the boot log into its own
		 * buffer at 0x0100_8000 forever; Linux simply points the
		 * hardware somewhere else and owns the screen from that
		 * instant.
		 *
		 * ⚠️ The driver writes offset 0x04 and nothing else. Offset
		 * 0x00 also holds `uart_b0`, which moves the serial console to
		 * uo[6] and pairs with the SW3 DIP switch — a read-modify-write
		 * from Linux could move the console out from under whoever is
		 * watching it.
		 */
		vgacon0: koticon@40000 {
			compatible = "koti,vga-text";
			reg = <0x00040000 0x0000000c>;
		};
	};
};
