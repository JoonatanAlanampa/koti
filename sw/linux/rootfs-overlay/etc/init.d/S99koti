#!/bin/sh
#
# S99koti — say, from userspace, that userspace is running.
#
# WHY THIS EXISTS. test/tb_boot.v needs one unambiguous string that only a
# working userspace can produce, and it must be OURS rather than borrowed from
# busybox's own output. A marker taken from a getty banner or /etc/issue would
# be a claim about how Buildroot happens to word things this release, and it
# would change under us on an upgrade with no warning and no failing test —
# just a boot that quietly stopped being checked.
#
# It runs last (S99) on purpose: everything else in /etc/init.d has already
# run, /proc and /dev are mounted, and the shell that runs this script is
# itself proof that execve, the dynamic-free static binary, the initramfs
# unpack and the console all worked.
#
# ⚠️ Keep the marker string in sync with MARKER in test/tb_boot.v. They are
# deliberately duplicated rather than generated: the bench must not learn what
# to expect from the thing it is testing.
#
# Copyright (c) 2026 Joonatan Alanampa
# SPDX-License-Identifier: Apache-2.0

case "$1" in
	start)
		# A little context first, because the interesting failures on real
		# hardware are "it booted but the machine is not what I think".
		# uname carries the kernel version and the machine name; the
		# memory line is how you find out the initramfs did not leave
		# enough room to do anything.
		/bin/busybox uname -a
		/bin/busybox grep -E '^MemTotal|^MemFree' /proc/meminfo
		echo "koti: userspace is alive"

		# ---- PROCESS WATCH (debug, 2026-08-09) --------------------------
		# The open bug: after a burst of typing, BOTH consoles stop showing
		# characters while the kernel stays healthy -- ticks flowing, the
		# keyboard ISR still draining its queue, the machine idle in
		# do_idle. Everything in hardware was cleared by measurement, and
		# what is left is that neither getty is reading its console any
		# more, with init never respawning one.
		#
		# ⛔ WHY NOT CONFIG_DETECT_HUNG_TASK: it only reports tasks in
		# UNINTERRUPTIBLE (D) sleep. A getty blocked on an ordinary read()
		# is in INTERRUPTIBLE (S) sleep, which that detector ignores by
		# design -- it would have cost a 26 minute build to learn nothing.
		#
		# This works instead because the timer fix (sbi.c, 0551bc8) means
		# userspace still gets scheduled during the failure. It writes to
		# /dev/console, which is hvc0 -> the UART, proven alive and
		# transmitting throughout. So the machine reports on its own
		# processes while the bug is happening.
		#
		# What to read: whether the two getty processes still EXIST, and
		# their state letter -- S is a live blocked reader, Z a zombie
		# nobody reaped, and absent means they exited and init did not put
		# them back. Those are three different bugs.
		(
			while : ; do
				/bin/busybox sleep 20
				echo "--- koti procwatch ---" > /dev/console
				/bin/busybox ps -o pid,stat,comm,args \
					> /dev/console 2>&1
			done
		) &
		;;
	stop)
		;;
	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac
