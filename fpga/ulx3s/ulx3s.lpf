# ulx3s.lpf — Koti-1 on the ULX3S 85F (LFE5U-85F, CABGA381).
#
# PROVENANCE. Every site below is copied from `console/fpga/ulx3s.lpf`, where
# the whole set was diffed against the upstream
# emard/ulx3s doc/constraints/ulx3s_v20.lpf on 2026-07-30. Reusing a
# transcription that has already been checked once is safer than re-typing
# from the vendor file, which is what the previous version of this file
# (a TODO-riddled template) invited.
#
# `python fpga/ulx3s/check_pins.py` re-proves the match mechanically and also
# catches the failure this file is most prone to: a harness port that has no
# LOCATE, or a LOCATE for a port that no longer exists.
#
# STILL UNVERIFIED, and only the board can settle it: whether YOUR board is a
# v2.0. A wrong revision builds perfectly and drives the wrong balls, which is
# why reading the silkscreen is step 1 of README.md.
#
# Header plan:
#   J1 (gp/gn 0-3)   Cartridge Pmod or TT QSPI Pmod   -> uio[7:0]   <- SW1 flips rows
#   J2 (gp/gn 4-7)   Tiny VGA Pmod                    -> uo[7:0]    <- SW2 flips rows
#   btn 1-6          GPIO inputs (MMIO 0x10008)       -> ui[7:2]

LOCATE COMP "clk_25mhz" SITE "G2";
IOBUF  PORT "clk_25mhz" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_25mhz" 25 MHZ;

# btn[0] = PWR (pulled up, press = 0 = reset). btn[1..6] feed ui[7:2].
LOCATE COMP "btn[0]" SITE "D6";
LOCATE COMP "btn[1]" SITE "R1";
LOCATE COMP "btn[2]" SITE "T1";
LOCATE COMP "btn[3]" SITE "R18";
LOCATE COMP "btn[4]" SITE "V1";
LOCATE COMP "btn[5]" SITE "U1";
LOCATE COMP "btn[6]" SITE "H16";
IOBUF PORT "btn[0]" PULLMODE=UP   IO_TYPE=LVCMOS33;
IOBUF PORT "btn[1]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF PORT "btn[2]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF PORT "btn[3]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF PORT "btn[4]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF PORT "btn[5]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF PORT "btn[6]" PULLMODE=DOWN IO_TYPE=LVCMOS33;

# SW1 = J1 row mapping, SW2 = J2 row mapping, SW3 = UART pin (headless uo[0]
# vs VGA-mode uo[6]), SW4 = LED view. Off = the reset-default personality.
LOCATE COMP "sw[0]" SITE "E8";
LOCATE COMP "sw[1]" SITE "D8";
LOCATE COMP "sw[2]" SITE "D7";
LOCATE COMP "sw[3]" SITE "E7";
IOBUF PORT "sw[0]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF PORT "sw[1]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF PORT "sw[2]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF PORT "sw[3]" PULLMODE=DOWN IO_TYPE=LVCMOS33;

LOCATE COMP "led[0]" SITE "B2";
LOCATE COMP "led[1]" SITE "C2";
LOCATE COMP "led[2]" SITE "C1";
LOCATE COMP "led[3]" SITE "D2";
LOCATE COMP "led[4]" SITE "D1";
LOCATE COMP "led[5]" SITE "E2";
LOCATE COMP "led[6]" SITE "E1";
LOCATE COMP "led[7]" SITE "H3";
IOBUF PORT "led[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

# FPGA -> host serial. PULLMODE=UP so the line idles high (UART idle) even
# while the FPGA is unconfigured, which stops the host seeing a break.
LOCATE COMP "ftdi_rxd" SITE "L4";
# The other direction: what the FTDI transmits and koti receives. Site from
# upstream ulx3s_v20.lpf. PULLMODE=UP so an unplugged or idle line reads HIGH,
# which is what a serial line idles at -- a floating input would look like an
# endless stream of start bits.
LOCATE COMP "ftdi_txd" SITE "M1";
IOBUF  PORT "ftdi_txd" PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF  PORT "ftdi_rxd" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;

# keep the ESP32 booted (it can power-cycle the board otherwise)
#
# L2 -> F1, 2026-08-07, following console/fpga/ulx3s.lpf, which changed it on
# the day that repo's design first ran on this board. This is the ONLY site in
# either file that differs between ULX3S revisions, and check_pins.py's
# cross-check against console's file is what caught the drift here — koti's copy
# had been left behind, which would have turned the next fpga-ulx3s run red.
#
#       v2.0 / v3.0.x : L2 = wifi_gpio0
#       v3.1.x        : L2 = wifi_gpio22, and wifi_gpio0 moved to F1
#
# Upstream's own v3.1.x file annotates it: `LOCATE COMP "wifi_gpio22" SITE "L2";
# # wifi_gpio0 on v3.0.x`. Exactly five signals moved between the revisions and
# all five are wifi_*; the other 58 sites — including every SDRAM pin and the
# whole of J1/J2 — are byte-identical, which is why the rest of this file is safe
# on this board whatever revision it turns out to be.
#
# ⚠️ Harmless either way, and worth knowing so nobody "fixes" it back: this line
# only hangs a weak pull-up on a pin, so at the wrong site the PROTECTION is
# simply absent rather than something being driven wrongly. ⛔ And do not read
# the board's USB descriptor as the answer — it says "ULX3S FPGA 85K v3.0.8",
# which is stale factory EEPROM data, not the PCB revision.
LOCATE COMP "wifi_gpio0" SITE "F1";
# J5 = wifi_en on v3.1.x, and NOT ASSIGNED in the v2.0/v3.0.x file — so holding
# it low costs nothing there and disables the ESP32 here. Both candidate enables
# are driven low because the revision is not settled and the SD bus is shared.
LOCATE COMP "wifi_en" SITE "J5";
IOBUF  PORT "wifi_en" PULLMODE=DOWN IO_TYPE=LVCMOS33;
# PULLMODE=DOWN, not UP: this pin is now DRIVEN LOW to keep the ESP32 off the
# microSD bus it shares with us (sd_* are wifi_gpio2/4/12/13/14/15). A pull-up
# here would fight the driver during configuration, which is the window where an
# awake ESP32 could grab the card. See the long comment in ulx3s_top.sv — and
# note F1 is `wifi_en` on a v3.0.x board and `wifi_gpio0` only on v3.1.x.
IOBUF  PORT "wifi_gpio0" PULLMODE=DOWN IO_TYPE=LVCMOS33;

# The ESP32's own serial pair (PLAN item 11, networking). Taken from upstream's
# v3.1.6 constraint file, which is the revision this board is closest to, and
# CHECKED against the v2.0 file: unlike wifi_en (F1 -> J5) and wifi_gpio0
# (L2 -> F1), these two sites are the same in both, so the revision trap that
# caught wifi_gpio0 does not apply here.
#   wifi_rxd = "FPGA transmits to WiFi"  -> koti drives it
#   wifi_txd = "FPGA receives from WiFi" -> koti reads it
# PULLMODE=UP on both because an idle serial line is HIGH: a floating receive
# pin reads as an endless run of start bits and the receiver decodes noise.
LOCATE COMP "wifi_rxd" SITE "K3";
IOBUF  PORT "wifi_rxd" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "wifi_txd" SITE "K4";
IOBUF  PORT "wifi_txd" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;

# ---- onboard microSD, driven in SPI mode ----
# Sites copied from console/fpga/ulx3s.lpf, which has run this exact bus on this
# exact board. sd_d[0] is MISO and is an input here; the others are driven.
# sd_cdn (N5) is deliberately NOT constrained: ulx3s_v20.lpf marks it "not
# connected", so gating anything on it would mean reading "no card" forever on a
# board where the pin is not wired. An absent card is detected by init failing,
# which is bounded and cannot hang.
LOCATE COMP "sd_clk"  SITE "H2";
LOCATE COMP "sd_cmd"  SITE "J1";
LOCATE COMP "sd_d[0]" SITE "J3";
LOCATE COMP "sd_d[1]" SITE "H1";
LOCATE COMP "sd_d[2]" SITE "K1";
LOCATE COMP "sd_d[3]" SITE "K2";
IOBUF PORT "sd_clk"  PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sd_cmd"  PULLMODE=UP   IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sd_d[0]" PULLMODE=UP   IO_TYPE=LVCMOS33;
IOBUF PORT "sd_d[1]" PULLMODE=UP   IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sd_d[2]" PULLMODE=UP   IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sd_d[3]" PULLMODE=UP   IO_TYPE=LVCMOS33 DRIVE=4;

# ---- US2: USB HID keyboard, straight onto the FPGA ----
# The BIDIRECTIONAL pair. `usb_fpga_dp/dn` (E16/F16) are the differential
# input-only pair and cannot drive a bus, so they are the wrong pins for a host.
# `usb_fpga_pu_dp/dn` (B12/C12) are the pull controls and are deliberately NOT
# constrained: US2 carries the host-side pull-downs on the board, and the core
# author's own ULX3S example leaves those two commented out.
# PULLMODE=NONE matters — an FPGA pull-up on D+ would look to the host logic
# like a device announcing itself, permanently.
LOCATE COMP "usb_fpga_bd_dp" SITE "D15";
LOCATE COMP "usb_fpga_bd_dn" SITE "E15";
IOBUF PORT "usb_fpga_bd_dp" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "usb_fpga_bd_dn" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

# ---- GPDI / HDMI: koti's standard video output (user directive 2026-08-07) ----
# Sites are byte-identical between upstream ulx3s_v20.lpf and the v3.1.x
# prototype file (console diffed them 2026-08-06), so they are correct on the
# v3.1.8 board on the bench — and console drove a real monitor through them.
#
# ⚠️ ONLY the _p pin of each pair is declared. IO_TYPE=LVCMOS33D makes the ECP5
# drive the paired _n site with the complement automatically; declaring
# gpdi_dn as well would put a SECOND DRIVER on the same differential pair.
LOCATE COMP "gpdi_dp[0]" SITE "A16";
LOCATE COMP "gpdi_dp[1]" SITE "A14";
LOCATE COMP "gpdi_dp[2]" SITE "A12";
LOCATE COMP "gpdi_dp[3]" SITE "A17";
IOBUF PORT "gpdi_dp[0]" IO_TYPE=LVCMOS33D DRIVE=4;
IOBUF PORT "gpdi_dp[1]" IO_TYPE=LVCMOS33D DRIVE=4;
IOBUF PORT "gpdi_dp[2]" IO_TYPE=LVCMOS33D DRIVE=4;
IOBUF PORT "gpdi_dp[3]" IO_TYPE=LVCMOS33D DRIVE=4;

# ---- J1: QSPI memory Pmod (bidirectional) ----
# Carries uio[7:0] = CS0, SD0, SD1, SCK, SD2, SD3, CS1, CS2 in TT order.
# The Cartridge Pmod fits here: it is a TT QSPI Pmod with CS2 (uio[7])
# replaced by an audio chain, and koti holds CS2 permanently high, so the
# pin koti does not use is exactly the pin the Cartridge Pmod repurposed.
# PULLMODE=UP keeps the chip selects deasserted while the FPGA configures.
LOCATE COMP "pmod_gp[0]" SITE "B11";
LOCATE COMP "pmod_gp[1]" SITE "A10";
LOCATE COMP "pmod_gp[2]" SITE "A9";
LOCATE COMP "pmod_gp[3]" SITE "B9";
LOCATE COMP "pmod_gn[0]" SITE "C11";
LOCATE COMP "pmod_gn[1]" SITE "A11";
LOCATE COMP "pmod_gn[2]" SITE "B10";
LOCATE COMP "pmod_gn[3]" SITE "C10";
IOBUF PORT "pmod_gp[0]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "pmod_gp[1]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "pmod_gp[2]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "pmod_gp[3]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "pmod_gn[0]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "pmod_gn[1]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "pmod_gn[2]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "pmod_gn[3]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;

# ---- J2: Tiny VGA Pmod (outputs) ----
# Carries uo[7:0]. In koti's VGA personality that is
# {HSync, B0/UART, G0, R0, VSync, B1, G1, R1} — the Tiny VGA Pmod order.
# In the headless personality the same pins carry UART/HALTED/LEDs, which is
# harmless: a monitor sees no sync and stays blank, which is correct.
LOCATE COMP "vga_gp[0]" SITE "A7";
LOCATE COMP "vga_gp[1]" SITE "C8";
LOCATE COMP "vga_gp[2]" SITE "C6";
LOCATE COMP "vga_gp[3]" SITE "A6";
LOCATE COMP "vga_gn[0]" SITE "A8";
LOCATE COMP "vga_gn[1]" SITE "B8";
LOCATE COMP "vga_gn[2]" SITE "C7";
LOCATE COMP "vga_gn[3]" SITE "B6";
IOBUF PORT "vga_gp[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "vga_gp[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "vga_gp[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "vga_gp[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "vga_gn[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "vga_gn[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "vga_gn[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "vga_gn[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;

# ---- J1 rows 8 and 9: the DS3231 RTC module's I2C bus (PLAN item 28) ----
#
# These three pins carried the PS/2 clock and data until 2026-08-08, when PS/2
# was removed because the USB keyboard had typed on real hardware. They are
# the I2C bus now.
#
# WHERE THEY ARE ON THE BOARD, from the ULX3S KiCad PCB (emard/ulx3s,
# ulx3s.kicad_pcb, read 2026-08-14 rather than remembered — J1 is a
# Socket_Strip_Angled_2x20 and its pad nets are in the file):
#
#   rtc_scl  gp[8]  A4   J1 pin 26   row "8", the "+" hole (outer column)
#   rtc_sda  gp[9]  A2   J1 pin 28   row "9", the "+" hole
#   rtc_sqw  gn[8]  A5   J1 pin 25   row "8", the "-" hole (inner column)
#   power         J1 pins 19/20 = 2V5_3V3, pins 21/22 = GND — the pair of rows
#                 immediately below row 7, inside the same 2x10 block.
#
# ⚠️ J1's supply net is `2V5_3V3`, NOT a fixed 3.3 V rail: it is bank 0's VCCIO
# and follows the RV2/RV3 0-ohm jumpers beside the "3.3V / 2.5V" silk. Boards
# ship at 3.3 V. Either value is inside the DS3231's 2.3-5.5 V range, and
# because this master can only ever pull DOWN (see ulx3s_top.sv), a rail
# mismatch cannot drive current into the part — at 2.5 V the module's pull-ups
# still present a valid LVCMOS33 high (VIH 2.0 V) to these inputs.
#
# ⭐ PULLMODE=UP ON ALL THREE, AND IT IS NOT BELT-AND-BRACES. The RTC module
# carries its own 4.7k pull-ups, which dominate when it is plugged in — but
# with nothing attached these pins would otherwise float, and a floating input
# on an open-drain bus reads as whatever the last edge left on the trace. The
# weak internal pull-up is what makes "no RTC connected" read as a clean idle
# bus (0x6932631F at 0x0009_0000) instead of as noise. It is also what makes
# rtc_sqw, which nothing drives today, read 1 rather than oscillate.
# ⚠️ A pull-up only takes effect on a pin the tools built a real IO buffer for
# — see the sd_d[0] story in ulx3s_top.sv, where losing the tristate silently
# lost the pull-up with it. fpga/ulx3s/check_tristate.py is the gate for that.
LOCATE COMP "rtc_scl" SITE "A4";
LOCATE COMP "rtc_sda" SITE "A2";
LOCATE COMP "rtc_sqw" SITE "A5";
# DRIVE is irrelevant on an open-drain output that only ever sinks the bus's
# pull-up current, and 4 mA is comfortably more than a 4.7k resistor asks for.
IOBUF PORT "rtc_scl" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "rtc_sda" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "rtc_sqw" PULLMODE=UP IO_TYPE=LVCMOS33;

# ---- E12 / B19: the onboard MCP7940N RTC (added 2026-08-14) ----
#
# ⭐ THE ULX3S HAS HAD A BATTERY-BACKED RTC ALL ALONG and this project had not
# noticed. U7 is a populated MCP7940N with its own 32.768 kHz crystal (Y2) and
# a CR1225 holder (BAT1, empty); its I2C bus goes STRAIGHT TO THE FPGA on these
# two balls, with 3.3k pull-ups (R22/R23) already fitted. Read out of the ULX3S
# KiCad PCB, then confirmed against upstream's own constraint file, which names
# them and says so:
#     LOCATE COMP "gpdi_sda" SITE "B19"; # I2C shared with RTC
#     LOCATE COMP "gpdi_scl" SITE "E12"; # I2C shared with RTC C12->E12
#
# ⚠️ SHARED WITH THE HDMI CONNECTOR'S DDC PINS through U11, a PCA9306 level
# translator — that is how a board reads a monitor's EDID. Two consequences:
# a monitor's EDID EEPROM (0x50) may answer on this bus alongside the RTC
# (0x6F), which is harmless because the addresses differ; and the pull-ups go
# to +2V5, not 3.3 V. An LVCMOS33 input reads 2.5 V as a valid high (VIH 2.0 V)
# and this master only ever pulls DOWN, so nothing here drives current into
# anything — the same argument as J1's 2V5_3V3 rail above.
#
# IO_TYPE and PULLMODE copied from upstream rather than chosen: those two lines
# are the vendor's own settings for these balls.
LOCATE COMP "rtc2_scl" SITE "E12";
LOCATE COMP "rtc2_sda" SITE "B19";
IOBUF PORT "rtc2_scl" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "rtc2_sda" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;

# gn[9] (B1) and gp/gn[10..13] are still FREE, and so is the whole of J2.

# ---- onboard 32 MB SDRAM (16-bit) ----
# Sites from upstream emard/ulx3s doc/constraints/ulx3s_v20.lpf, fetched
# 2026-08-02. PULLMODE=NONE throughout: these are point-to-point traces to a
# single soldered part, and a pull-up on a 16-bit bus is 16 needless fights.
# DRIVE=4 matches upstream; the bus is short and lightly loaded at 25 MHz.
LOCATE COMP "sdram_clk" SITE "F19";
LOCATE COMP "sdram_cke" SITE "F20";
LOCATE COMP "sdram_csn" SITE "P20";
LOCATE COMP "sdram_wen" SITE "T20";
LOCATE COMP "sdram_rasn" SITE "R20";
LOCATE COMP "sdram_casn" SITE "T19";
LOCATE COMP "sdram_a[0]" SITE "M20";
LOCATE COMP "sdram_a[1]" SITE "M19";
LOCATE COMP "sdram_a[2]" SITE "L20";
LOCATE COMP "sdram_a[3]" SITE "L19";
LOCATE COMP "sdram_a[4]" SITE "K20";
LOCATE COMP "sdram_a[5]" SITE "K19";
LOCATE COMP "sdram_a[6]" SITE "K18";
LOCATE COMP "sdram_a[7]" SITE "J20";
LOCATE COMP "sdram_a[8]" SITE "J19";
LOCATE COMP "sdram_a[9]" SITE "H20";
LOCATE COMP "sdram_a[10]" SITE "N19";
LOCATE COMP "sdram_a[11]" SITE "G20";
LOCATE COMP "sdram_a[12]" SITE "G19";
LOCATE COMP "sdram_ba[0]" SITE "P19";
LOCATE COMP "sdram_ba[1]" SITE "N20";
LOCATE COMP "sdram_d[0]" SITE "J16";
LOCATE COMP "sdram_d[1]" SITE "L18";
LOCATE COMP "sdram_d[2]" SITE "M18";
LOCATE COMP "sdram_d[3]" SITE "N18";
LOCATE COMP "sdram_d[4]" SITE "P18";
LOCATE COMP "sdram_d[5]" SITE "T18";
LOCATE COMP "sdram_d[6]" SITE "T17";
LOCATE COMP "sdram_d[7]" SITE "U20";
LOCATE COMP "sdram_d[8]" SITE "E19";
LOCATE COMP "sdram_d[9]" SITE "D20";
LOCATE COMP "sdram_d[10]" SITE "D19";
LOCATE COMP "sdram_d[11]" SITE "C20";
LOCATE COMP "sdram_d[12]" SITE "E18";
LOCATE COMP "sdram_d[13]" SITE "F18";
LOCATE COMP "sdram_d[14]" SITE "J18";
LOCATE COMP "sdram_d[15]" SITE "J17";
LOCATE COMP "sdram_dqm[0]" SITE "U19";
LOCATE COMP "sdram_dqm[1]" SITE "E20";

IOBUF PORT "sdram_clk" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_cke" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_csn" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_wen" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_rasn" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_casn" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_a[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_a[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_a[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_a[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_a[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_a[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_a[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_a[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_a[8]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_a[9]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_a[10]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_a[11]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_a[12]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_ba[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_ba[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_d[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_d[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_d[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_d[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_d[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_d[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_d[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_d[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_d[8]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_d[9]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_d[10]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_d[11]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_d[12]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_d[13]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_d[14]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_d[15]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_dqm[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "sdram_dqm[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

# ---- onboard 3.5 mm audio jack (4-bit R2R ladder per channel) ----
# ⭐ THE ONLY AUDIO PATH THAT NEEDS NO PMOD. These eight pins ARE the DAC: each
# channel is a resistor ladder driven straight from the FPGA, so the socket on
# the board is the output and nothing else has to be plugged in.
#
# Every site is copied VERBATIM from console/fpga/ulx3s.lpf, which was diffed
# against upstream ulx3s_v20.lpf and then PROVEN on this exact board — console's
# tune_top.sv played Ode to Joy out of this jack on 2026-08-04. None of these is
# in the set that moved on PCB v3.1.x (only five wifi_* pins did).
#
# ⚠️ DRIVE=4 deliberately, matching console. The ladder is a resistive load
# straight off the pin; a stronger drive buys nothing an audio DAC wants and
# couples more switching noise into the board's analog corner.
LOCATE COMP "audio_l[3]" SITE "B3";     # JACK TIP (left)
LOCATE COMP "audio_l[2]" SITE "C3";
LOCATE COMP "audio_l[1]" SITE "D3";
LOCATE COMP "audio_l[0]" SITE "E4";
LOCATE COMP "audio_r[3]" SITE "C5";     # JACK RING1 (right)
LOCATE COMP "audio_r[2]" SITE "D5";
LOCATE COMP "audio_r[1]" SITE "B5";
LOCATE COMP "audio_r[0]" SITE "A3";
IOBUF PORT "audio_l[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "audio_l[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "audio_l[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "audio_l[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "audio_r[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "audio_r[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "audio_r[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "audio_r[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
